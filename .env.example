DATABASE_URL="file:./prisma/prod.db"
NODE_ENV="production"

# Public URL of the app (used in e-mail links and social previews)
APP_BASE_URL="https://odkrywca.karwia.pl"
NEXT_PUBLIC_BASE_URL="https://odkrywca.karwia.pl"

# Required. Avoid the "$" character (Next.js expands it in .env files) or escape it as "\$"
ADMIN_PASSWORD=""
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=""

SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Odkrywca Karwii <noreply@karwia.pl>"

# Optional: custom map tiles (default: OpenStreetMap, no key needed). Baked in at build time.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.example.com/{z}/{x}/{y}.png?key=..."
# NEXT_PUBLIC_MAP_ATTRIBUTION="© ..."
