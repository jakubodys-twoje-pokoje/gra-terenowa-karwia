generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Building {
  id              Int      @id @default(autoincrement())
  name            String
  description     String
  address         String?
  lat             Float
  lng             Float
  imageUrl        String?
  outlineImageUrl String?
  qrUrl           String   @unique
  category        String   @default("landmark")
  hidden          Boolean  @default(false)
  published       Boolean  @default(true)
  discoveries     UserDiscovery[]
  images          BuildingImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BuildingImage {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
}

model UserDiscovery {
  id           Int      @id @default(autoincrement())
  userId       String
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  discoveredAt DateTime @default(now())

  @@unique([userId, buildingId])
  @@index([userId])
}

model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  nickname      String?
  email         String?  @unique
  city          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PageContent {
  key       String   @id
  html      String   @default("")
  updatedAt DateTime @updatedAt
}

model Category {
  id    Int    @id @default(autoincrement())
  value String @unique
  label String
  icon  String @default("")
  order Int    @default(0)
}

model Achievement {
  id                Int     @id @default(autoincrement())
  name              String
  description       String
  icon              String  @default("🏆")
  color             String  @default("#0F5F92")
  conditionType     String  // total_count | total_all | category_count
  conditionValue    Int     @default(1)
  conditionCategory String?
  order             Int     @default(0)
}

model EmailVerificationToken {
  id          Int      @id @default(autoincrement())
  userId      String
  guestUserId String?
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}
