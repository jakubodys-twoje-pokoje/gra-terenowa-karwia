generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Building {
  id              Int      @id @default(autoincrement())
  name            String
  description     String
  address         String?
  lat             Float
  lng             Float
  imageUrl        String?
  outlineImageUrl String?
  qrUrl           String   @unique
  category        String   @default("landmark")
  discoveries     UserDiscovery[]
  images          BuildingImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BuildingImage {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
}

model UserDiscovery {
  id           Int      @id @default(autoincrement())
  userId       String
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  discoveredAt DateTime @default(now())

  @@unique([userId, buildingId])
  @@index([userId])
}

model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  nickname      String?
  email         String?  @unique
  city          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailVerificationToken {
  id          Int      @id @default(autoincrement())
  userId      String
  guestUserId String?
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}
