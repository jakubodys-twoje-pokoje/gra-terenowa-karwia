generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Building {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  address     String?
  lat         Float
  lng         Float
  imageUrl    String?
  qrUrl       String   @unique
  category    String   @default("landmark")
  discoveries UserDiscovery[]
  images      BuildingImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuildingImage {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
}

model UserDiscovery {
  id           Int      @id @default(autoincrement())
  userId       String
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  discoveredAt DateTime @default(now())

  @@unique([userId, buildingId])
  @@index([userId])
}
