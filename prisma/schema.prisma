generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Building {
  id              Int      @id @default(autoincrement())
  number          Int?     // physical sign number on the building
  name            String
  description     String   // HTML from rich text editor
  address         String?
  lat             Float
  lng             Float
  imageUrl        String?
  outlineImageUrl String?
  qrUrl           String   @unique
  category        String   @default("landmark")
  hidden          Boolean  @default(false)
  published       Boolean  @default(true)
  discoveries     UserDiscovery[]
  images          BuildingImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model BuildingImage {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  url        String
  title      String?  // caption shown in lightbox
  alt        String?  // alt text / image description from meta
  order      Int      @default(0)
}

model UserDiscovery {
  id           Int      @id @default(autoincrement())
  userId       String
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  discoveredAt DateTime @default(now())

  @@unique([userId, buildingId])
  @@index([userId])
}

model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  nickname      String?
  email         String?  @unique
  city          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  guestUserId   String?
  showOnMap     Boolean  @default(false)
  lastLat       Float?
  lastLng       Float?
  lastSeenAt    DateTime?
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PageContent {
  key       String   @id
  html      String   @default("")
  updatedAt DateTime @updatedAt
}

model Category {
  id    Int    @id @default(autoincrement())
  value String @unique
  label String
  icon  String @default("")
  order Int    @default(0)
}

model Achievement {
  id                Int     @id @default(autoincrement())
  name              String
  description       String
  icon              String  @default("🏆")
  color             String  @default("#0F5F92")
  conditionType     String  // total_count | total_all | category_count | building_set | days_active | all_in_one_day | return_after_break
  conditionValue    Int     @default(1)
  conditionCategory String?
  buildingIds       String? // JSON array of building IDs, used for building_set type
  order             Int     @default(0)
}

model EasterEgg {
  id                Int      @id @default(autoincrement())
  name              String   // internal label (admin only)
  title             String   // shown to user
  description       String?
  mediaType         String   @default("none") // none | image | video | audio
  mediaUrl          String?
  triggerType       String   // discovery_count | every_n | building
  triggerValue      Int?     // discovery_count: show at exactly N; every_n: show every N
  triggerBuildingId Int?     // building trigger: building id
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  views             EasterEggView[]
}

model EasterEggView {
  id        Int       @id @default(autoincrement())
  userId    String
  eggId     Int
  egg       EasterEgg @relation(fields: [eggId], references: [id], onDelete: Cascade)
  milestone Int       @default(0)  // for every_n: which multiple fired (1=first, 2=second…)
  seenAt    DateTime  @default(now())

  @@unique([userId, eggId, milestone])
  @@index([userId])
}

model EmailVerificationToken {
  id          Int      @id @default(autoincrement())
  userId      String
  guestUserId String?
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String   // e.g. "/", "/baza", "/budynek/5"
  userId    String?  // guest UUID or registered userId (optional)
  sessionId String   // random per-session UUID (localStorage)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}
